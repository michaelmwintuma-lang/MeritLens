# Settings for deploy/docker-compose.yml. Copy to deploy/.env (never committed) and fill in.

# The address people use. Its DNS must point at this server, with ports 80 and 443 open.
DOMAIN=meritlens.example.org
# Choose long random values (e.g. python -c "import secrets; print(secrets.token_urlsafe(24))")
DB_PASSWORD=
DEMO_PASSWORD=
APP_SECRET_KEY=
# Where the nightly backups go on this server (best: another disk)
BACKUP_PATH=/mnt/backups/meritlens

# Recommended for real use (see backend/.env.example for what each does)
REQUIRE_2FA_ROLES=hr,finance,admin
FOUR_EYES=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
