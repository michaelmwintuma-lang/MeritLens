# The public address: Caddy gets a free HTTPS certificate for DOMAIN (Let's Encrypt) and renews it by itself. The
# domain's DNS must point at this server, with ports 80 and 443 open. DOMAIN=localhost gives a local certificate
# for trying it out.
{$DOMAIN} {
	encode zstd gzip

	# The API
	handle /api/* {
		reverse_proxy api:8000
	}

	# The website: a single-page app, so every other address serves index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# The same security headers as `npm run preview` (frontend/vite.config.js), and HTTPS only
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Long caching for the built files, whose names change with their content
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
