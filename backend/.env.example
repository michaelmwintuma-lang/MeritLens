# Copy this file to ".env" (in this backend folder) and fill in your own values.
# .env is private: it is never committed or shared.

# ─── Email (Gmail) ────────────────────────────────────────────────────────────
# 1. Your Google account needs 2-Step Verification switched on.
# 2. Create an App password: https://myaccount.google.com/apppasswords  (name it e.g. "Promotion platform")
# 3. Paste the 16-letter code below (spaces are fine). Never use your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_SENDER_NAME=Promotion & Reporting

# Where "Book a demo" requests are emailed (leave empty to use SMTP_USER above)
DEMO_INBOX=

# The website address used in email links
APP_URL=http://127.0.0.1:5173
