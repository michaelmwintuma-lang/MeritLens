# Copy this file to ".env" (in this backend folder) and fill in your own values.
# .env is private: it is never committed or shared.

# ─── Email (Gmail) ────────────────────────────────────────────────────────────
# 1. Your Google account needs 2-Step Verification switched on.
# 2. Create an App password: https://myaccount.google.com/apppasswords  (name it e.g. "Promotion platform")
# 3. Paste the 16-letter code below (spaces are fine). Never use your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_SENDER_NAME=MeritLens
# starttls (port 587, as above) or ssl (port 465)
SMTP_SECURITY=starttls

# ─── Email for real use: a transactional email service instead of Gmail ───────
# Gmail is fine for a demo. For real staff, use a service built for it (better delivery, sender authentication with
# SPF and DKIM on your own domain, bounce reports). Only these settings change; nothing in the code does.
#   Brevo:      SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<your login>  SMTP_PASSWORD=<SMTP key>
#   Postmark:   SMTP_HOST=smtp.postmarkapp.com  SMTP_PORT=587  SMTP_USER=<server token>  SMTP_PASSWORD=<server token>
#   Amazon SES: SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587  SMTP_USER/SMTP_PASSWORD=<SMTP credentials>
#   Mailgun:    SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587  SMTP_USER=postmaster@<your domain>  SMTP_PASSWORD=<password>
# With these, also set the address emails come from (a verified sender on your domain):
# SMTP_SENDER=hr-platform@your-company.com

# A host that blocks the mail ports (such as Render's free plan): send through Brevo's email API over HTTPS instead.
# brevo.com > SMTP & API > API keys. When set, it is used instead of SMTP_HOST. The sender (SMTP_SENDER, or
# SMTP_USER) must be a sender verified in Brevo (Senders, domains & dedicated IPs > Senders).
# BREVO_API_KEY=xkeysib-...

# ─── Reminders and digests ────────────────────────────────────────────────────
# The app's timer retries emails every minute, sends reminders every hour, and sends the daily digest at this hour
# (local time, 0-23). SCHEDULER=0 switches the timer off.
DIGEST_HOUR=9
SCHEDULER=1

# Where "Book a demo" requests are emailed (leave empty to use SMTP_USER above)
DEMO_INBOX=

# The website address used in email links
APP_URL=http://127.0.0.1:5173

# ─── Security ─────────────────────────────────────────────────────────────────
# Roles that must use two-factor sign-in (an authenticator app). Empty: anyone may choose to. Recommended for real use:
REQUIRE_2FA_ROLES=
# REQUIRE_2FA_ROLES=hr,finance,admin
# Roles that get a one-time code by email at every sign-in (10 minutes, one use). Someone with an authenticator app
# enters its code instead. Their accounts need a real email address. Empty: no email codes.
EMAIL_CODE_ROLES=
# EMAIL_CODE_ROLES=admin,hr,finance,auditor
# A second HR person must approve a model release, and a record correction that moves someone across the threshold.
# Needs at least two HR accounts. 0 = off.
FOUR_EYES=0

# ─── Personal data: how long it is kept (days), then removed automatically each morning ─
RETAIN_RATING_COMMENTS_DAYS=730
RETAIN_NOTIFICATIONS_DAYS=180
RETAIN_EMAIL_LOG_DAYS=365
RETAIN_ACTIVITY_LOG_DAYS=1095

# ─── Backups (docs/BACKUPS.md) ────────────────────────────────────────────────
# A backup every night at BACKUP_HOUR while the app runs; the newest BACKUP_KEEP are kept. BACKUPS=0 switches it off.
BACKUPS=1
BACKUP_HOUR=2
BACKUP_KEEP=14
# BACKUP_DIR=D:/meritlens-backups      (default: backend/instance/backups; best on another disk)

# ─── Logs and error alerts ────────────────────────────────────────────────────
# json: one JSON object per line, for a log service. Admins are emailed about an error at most once per
# ALERT_EVERY_MINUTES for each kind of error.
LOG_FORMAT=text
LOG_LEVEL=INFO
ALERT_EVERY_MINUTES=60
